# CasaDash configuration (bare metal / development).
# Copy to .env and adjust. In Docker and the Home Assistant add-on these are set by run.sh.

# Folder holding the SQLite database (cdash.db) and uploaded receipts (uploads/).
DATA_DIR=./data

# Optional: explicit database file. Defaults to $DATA_DIR/cdash.db.
# Also used by drizzle-kit (npm run db:*).
DATABASE_URL=./data/cdash.db

# HTTP server (npm start)
PORT=8099
HOST=0.0.0.0

# Session cookie "Secure" flag: auto (HTTPS only), true, false
COOKIE_SECURE=auto

# Maximum upload size for receipts and backup archives
BODY_SIZE_LIMIT=100M

# --- Security ---

# Behind a reverse proxy (nginx, Traefik, Caddy), read the real client address from this header
# so the login lockout counts per client and not per proxy. XFF_DEPTH = number of trusted proxies.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# Public URL(s) of CasaDash when a proxy rewrites the Host header (comma separated).
# Needed only if form posts are refused with "origine non consentita".
# TRUSTED_ORIGINS=https://casa.example.com

# Who may embed CasaDash in a frame (CSP frame-ancestors). Default: only itself.
# FRAME_ANCESTORS='self' https://homeassistant.local:8123

# Key that encrypts MFA secrets and bank credentials. If unset, a random key is created in
# DATA_DIR/secret.key (and included in backups). Set it to keep the key out of the data folder.
# CASADASH_SECRET_KEY=change-me-to-a-long-random-string
