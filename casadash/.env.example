# CasaDash configuration (bare metal / development).
# Copy to .env and adjust. In Docker and the Home Assistant add-on these are set by run.sh.

# Folder holding the SQLite database (cdash.db) and uploaded receipts (uploads/).
DATA_DIR=./data

# Optional: explicit database file. Defaults to $DATA_DIR/cdash.db.
# Also used by drizzle-kit (npm run db:*).
DATABASE_URL=./data/cdash.db

# HTTP server (npm start)
PORT=8099
HOST=0.0.0.0

# Session cookie "Secure" flag: auto (HTTPS only), true, false
COOKIE_SECURE=auto

# Maximum upload size for receipts and backup archives
BODY_SIZE_LIMIT=100M
